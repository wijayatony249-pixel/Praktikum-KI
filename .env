# Konfigurasi Port
PORT_GATEWAY=3000
PORT_NILAI=3001
PORT_TRANSKRIP=3002

# Kunci Rahasia Zero Trust
GATEWAY_SECRET=zt-gateway-super-secret-key-2026
JWT_ACCESS_SECRET=zt-access-token-secret-10m-key
JWT_REFRESH_SECRET=zt-refresh-token-secret-1d-key
JWT_SERVICE_SECRET=zt-service-token-secret-5m-key

# Service Client Credentials (M2M)
SERVICE_NILAI_CLIENT_ID=service-nilai-client
SERVICE_NILAI_CLIENT_SECRET=service-nilai-secret-2026

# Konfigurasi Jam Akses (Pukul 07.00 - 21.00)
# Dapat diubah untuk demonstrasi pengujian di luar jam operasional
ACCESS_HOURS_START=7
ACCESS_HOURS_END=21

# Override jam akses untuk kemudahan demo (jika 'true', sistem menggunakan SIMULATED_HOUR)
ACCESS_HOURS_SIMULATED_ENABLED=false
ACCESS_HOURS_SIMULATED_HOUR=22

